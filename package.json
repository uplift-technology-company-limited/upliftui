{
  "name": "upliftui",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter=@upliftui/ui build",
    "dev": "bun run --filter=@upliftui/ui dev",
    "build:registry": "bun scripts/build-registry.ts",
    "docs": "cd apps/docs && bun run start",
    "docs:build": "cd apps/docs && bun run build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "next-themes": "^0.4.6",
    "typescript": "^5.9.3"
  }
}
